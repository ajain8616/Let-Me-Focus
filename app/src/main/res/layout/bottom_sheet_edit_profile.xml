<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/padding_screen"
    android:background="@drawable/bottom_sheet_background">

    <!-- Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_large">

        <TextView
            android:id="@+id/tvEditProfileTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:text="Edit Profile"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/text_size_heading"
            android:fontFamily="@font/bold" />

        <ImageButton
            android:id="@+id/btnCloseProfileSheet"
            android:layout_width="@dimen/icon_size_large"
            android:layout_height="@dimen/icon_size_large"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/rounded_button_error"
            android:contentDescription="@string/close"
            android:padding="@dimen/padding_tiny"
            app:tint="@color/white"
            app:srcCompat="@drawable/ic_clear" />
    </RelativeLayout>

    <!-- Profile Image Container -->
    <LinearLayout
        android:id="@+id/profileImageContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="@dimen/margin_large"
        android:background="@drawable/background_glass"
        android:padding="@dimen/padding_large">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/avatar_shadow_size"
            android:layout_height="@dimen/avatar_shadow_size"
            app:cardCornerRadius="@dimen/radius_oval_shadow"
            app:cardElevation="@dimen/elevation_card"
            app:strokeWidth="@dimen/stroke_thick"
            app:strokeColor="@color/modern_primary"
            app:cardBackgroundColor="@color/transparent">

            <ImageView
                android:id="@+id/imgProfilePicture"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_profile"
                android:scaleType="centerCrop"
                android:contentDescription="@string/profile_image" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChangePhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:text="Change Photo"
            android:textColor="@color/modern_primary"
            android:fontFamily="@font/robotomedium"
            style="@style/Widget.Material3.Button.OutlinedButton"
            app:strokeColor="@color/modern_primary"
            app:strokeWidth="@dimen/stroke_thin" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Name Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/userNameInputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_standard"
            android:hint="@string/hint_name"
            app:boxBackgroundColor="@color/input_background"
            app:boxCornerRadiusBottomEnd="@dimen/radius_medium"
            app:boxCornerRadiusBottomStart="@dimen/radius_medium"
            app:boxCornerRadiusTopEnd="@dimen/radius_medium"
            app:boxCornerRadiusTopStart="@dimen/radius_medium"
            app:boxStrokeColor="@color/modern_primary"
            app:startIconDrawable="@drawable/ic_person_add"
            app:startIconTint="@color/modern_primary"
            app:hintTextColor="@color/modern_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUserName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/robotoregular"
                android:textColor="@color/textPrimary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Email Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/userEmailInputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_large"
            android:hint="@string/hint_email"
            app:boxBackgroundColor="@color/input_background"
            app:boxCornerRadiusBottomEnd="@dimen/radius_medium"
            app:boxCornerRadiusBottomStart="@dimen/radius_medium"
            app:boxCornerRadiusTopEnd="@dimen/radius_medium"
            app:boxCornerRadiusTopStart="@dimen/radius_medium"
            app:boxStrokeColor="@color/modern_primary"
            app:startIconDrawable="@drawable/ic_email"
            app:startIconTint="@color/modern_primary"
            app:hintTextColor="@color/modern_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUserEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/robotoregular"
                android:inputType="textEmailAddress"
                android:textColor="@color/textPrimary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_standard_height"
            android:backgroundTint="@color/modern_primary"
            android:text="@string/save"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_body_large"
            android:fontFamily="@font/bold"
            app:cornerRadius="@dimen/radius_medium" />
    </LinearLayout>
</LinearLayout>