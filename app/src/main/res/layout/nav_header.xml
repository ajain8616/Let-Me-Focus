<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:background="@drawable/nav_header_gradient"
    android:elevation="8dp"
    android:clipToPadding="false"
    android:paddingTop="20dp">

    <!-- Subtle Background Pattern -->
    <ImageView
        android:id="@+id/background_pattern"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:alpha="0.06"
        android:src="@drawable/bg_pattern"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Main Content Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Profile Image - Compact and Elegant -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/profile_image_card"
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:cardCornerRadius="40dp"
            app:cardElevation="8dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:cardBackgroundColor="@color/transparent">

            <ImageView
                android:id="@+id/avatar_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@string/profile_picture"
                android:src="@drawable/ic_profile"
                android:transitionName="avatarTransition"/>

        </com.google.android.material.card.MaterialCardView>

        <!-- Online Status Indicator -->
        <View
            android:id="@+id/online_status"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/online_status_badge"
            app:layout_constraintBottom_toBottomOf="@id/profile_image_card"
            app:layout_constraintEnd_toEndOf="@id/profile_image_card"
            android:elevation="4dp"/>

        <!-- Edit FAB - Smaller and Refined -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/edit_profile_fab"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            android:src="@drawable/ic_edit"
            app:backgroundTint="@color/primary"
            app:fabSize="mini"
            app:tint="@color/white"
            app:elevation="8dp"
            app:rippleColor="@color/primaryDark"
            app:layout_constraintBottom_toBottomOf="@id/profile_image_card"
            app:layout_constraintEnd_toEndOf="@id/profile_image_card"/>

        <!-- User Name - Refined Typography -->
        <TextView
            android:id="@+id/user_name_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/android_developer"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:ellipsize="end"
            android:maxLines="1"
            android:visibility="invisible"
            app:layout_constraintTop_toBottomOf="@id/profile_image_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"/>

        <!-- User Email - Subtle Appearance -->
        <TextView
            android:id="@+id/user_email_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/user_example_com"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:gravity="center"
            android:alpha="0.8"
            android:ellipsize="end"
            android:maxLines="1"
            android:visibility="invisible"
            app:layout_constraintTop_toBottomOf="@id/user_name_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="2dp"/>

        <!-- Status Chip - Compact and Clean -->
        <com.google.android.material.chip.Chip
            android:id="@+id/status_chip"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="@string/active_now"
            android:textSize="12sp"
            app:chipBackgroundColor="@color/statusSuccess"
            app:chipCornerRadius="14dp"
            app:chipIcon="@drawable/ic_online"
            app:chipIconTint="@color/white"
            app:chipIconSize="14dp"
            app:chipStrokeColor="@color/white"
            app:chipStrokeWidth="1dp"
            app:textStartPadding="10dp"
            app:textEndPadding="10dp"
            android:visibility="invisible"
            app:layout_constraintTop_toBottomOf="@id/user_email_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="10dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>