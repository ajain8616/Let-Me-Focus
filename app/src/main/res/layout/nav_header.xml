<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/nav_header_height"
    android:background="@drawable/nav_header_gradient"
    android:fitsSystemWindows="true"
    android:paddingTop="?attr/actionBarSize"
    android:paddingStart="@dimen/padding_large"
    android:paddingEnd="@dimen/padding_large"
    android:clipToPadding="false">

    <!-- Background Pattern -->
    <ImageView
        android:id="@+id/background_pattern"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:alpha="0.06"
        android:src="@drawable/bg_pattern"
        android:contentDescription="@string/blank"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Profile Image Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/profile_image_card"
        android:layout_width="@dimen/circular_shadow_size"
        android:layout_height="@dimen/circular_shadow_size"
        app:cardCornerRadius="@dimen/radius_oval_shadow"
        app:cardElevation="@dimen/margin_medium"
        app:strokeWidth="@dimen/stroke_thick"
        android:layout_marginTop="@dimen/margin_standard"
        app:strokeColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardBackgroundColor="@color/transparent">

        <ImageView
            android:id="@+id/avatar_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@string/profile_picture"
            android:src="@drawable/ic_profile"
            android:transitionName="avatarTransition"
            android:background="@drawable/circular_shadow"/>
    </com.google.android.material.card.MaterialCardView>

    <ImageButton
        android:id="@+id/edit_profile_button"
        android:layout_width="@dimen/margin_xxlarge"
        android:layout_height="@dimen/margin_xxlarge"
        android:background="@drawable/clickable_background"
        android:padding="@dimen/padding_small"
        android:src="@drawable/ic_edit"
        android:contentDescription="@string/profile_image"
        app:tint="@color/white"
        android:elevation="@dimen/elevation_floating"
        app:layout_constraintBottom_toBottomOf="@id/profile_image_card"
        app:layout_constraintEnd_toEndOf="@id/profile_image_card"
        android:layout_marginBottom="-4dp"
        android:layout_marginEnd="-4dp"/>

    <!-- User Name -->
    <TextView
        android:id="@+id/user_name_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/username"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_heading"
        android:fontFamily="@font/bold"
        android:gravity="center"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintTop_toBottomOf="@id/profile_image_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/margin_medium"/>

    <!-- User Email -->
    <TextView
        android:id="@+id/user_email_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/email"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_body_large"
        android:fontFamily="@font/robotoregular"
        android:gravity="center"
        android:alpha="0.85"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintTop_toBottomOf="@id/user_name_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/margin_tiny"/>

    <!-- Status Chip -->
    <com.google.android.material.chip.Chip
        android:id="@+id/status_chip"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/margin_xxlarge"
        android:text="@string/active"
        android:textSize="@dimen/text_size_body_small"
        android:fontFamily="@font/robotomedium"
        android:textColor="@color/white"
        app:chipBackgroundColor="@color/statusSuccess"
        app:chipCornerRadius="@dimen/radius_large"
        app:chipIcon="@drawable/ic_online"
        app:chipIconTint="@color/white"
        app:chipIconSize="@dimen/icon_size_standard"
        app:chipStrokeColor="@color/white"
        app:chipStrokeWidth="@dimen/stroke_thin"
        app:textStartPadding="@dimen/margin_medium"
        app:textEndPadding="@dimen/margin_medium"
        app:layout_constraintTop_toBottomOf="@id/user_email_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/margin_standard"/>

</androidx.constraintlayout.widget.ConstraintLayout>