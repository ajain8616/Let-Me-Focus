<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background"
    android:padding="@dimen/padding_screen">

    <!-- Close Button with Circular Red Background -->
    <ImageButton
        android:id="@+id/crossIcon"
        android:layout_width="@dimen/icon_size_large"
        android:layout_height="@dimen/icon_size_large"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:src="@drawable/ic_clear"
        android:background="@drawable/rounded_button_error"
        app:tint="@color/white"
        android:contentDescription="@string/close"
        android:scaleType="centerInside"
        android:padding="@dimen/padding_tiny" />

    <!-- Title -->
    <TextView
        android:id="@+id/chooseCategoryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/crossIcon"
        android:layout_marginTop="@dimen/margin_small"
        android:layout_marginBottom="@dimen/margin_large"
        android:gravity="center"
        android:text="@string/choose_your_category"
        android:textColor="@color/textPrimary"
        android:textSize="@dimen/text_size_heading"
        android:fontFamily="@font/bold"
        android:letterSpacing="0.01" />

    <!-- Filter Options -->
    <RadioGroup
        android:id="@+id/radioGroupCategories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/chooseCategoryText"
        android:orientation="vertical">

        <!-- Complete List -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCompleteList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_small"
            app:cardCornerRadius="@dimen/radius_medium"
            app:cardElevation="@dimen/elevation_subtle"
            app:strokeWidth="@dimen/stroke_thin"
            app:strokeColor="@color/border_gray"
            app:cardBackgroundColor="@color/surface">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:paddingHorizontal="@dimen/padding_large">

                <RadioButton
                    android:id="@+id/radioButtonCompleteList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:buttonTint="@color/modern_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/radioButtonCompleteList"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:text="@string/complete_list"
                    android:fontFamily="@font/robotomedium"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/text_size_subheading" />

            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Active -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardActive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_small"
            app:cardCornerRadius="@dimen/radius_medium"
            app:cardElevation="@dimen/elevation_subtle"
            app:strokeWidth="@dimen/stroke_thin"
            app:strokeColor="@color/border_gray"
            app:cardBackgroundColor="@color/surface">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:paddingHorizontal="@dimen/padding_large">

                <RadioButton
                    android:id="@+id/radioButtonActive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:buttonTint="@color/modern_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/radioButtonActive"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:text="@string/active"
                    android:fontFamily="@font/robotomedium"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/text_size_subheading" />

            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Inactive -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInactive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_small"
            app:cardCornerRadius="@dimen/radius_medium"
            app:cardElevation="@dimen/elevation_subtle"
            app:strokeWidth="@dimen/stroke_thin"
            app:strokeColor="@color/border_gray"
            app:cardBackgroundColor="@color/surface">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:paddingHorizontal="@dimen/padding_large">

                <RadioButton
                    android:id="@+id/radioButtonInactive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:buttonTint="@color/modern_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/radioButtonInactive"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:text="@string/inactive"
                    android:fontFamily="@font/robotomedium"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/text_size_subheading" />

            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Pause -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPause"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_small"
            app:cardCornerRadius="@dimen/radius_medium"
            app:cardElevation="@dimen/elevation_subtle"
            app:strokeWidth="@dimen/stroke_thin"
            app:strokeColor="@color/border_gray"
            app:cardBackgroundColor="@color/surface">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:paddingHorizontal="@dimen/padding_large">

                <RadioButton
                    android:id="@+id/radioButtonPause"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:buttonTint="@color/modern_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/radioButtonPause"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:text="@string/pause"
                    android:fontFamily="@font/robotomedium"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/text_size_subheading" />

            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Stop -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_small"
            app:cardCornerRadius="@dimen/radius_medium"
            app:cardElevation="@dimen/elevation_subtle"
            app:strokeWidth="@dimen/stroke_thin"
            app:strokeColor="@color/border_gray"
            app:cardBackgroundColor="@color/surface">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:paddingHorizontal="@dimen/padding_large">

                <RadioButton
                    android:id="@+id/radioButtonStop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:buttonTint="@color/modern_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/radioButtonStop"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:text="@string/stop"
                    android:fontFamily="@font/robotomedium"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/text_size_subheading" />

            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>

    </RadioGroup>

    <!-- Apply Filter Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/fetchDataButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_standard_height"
        android:layout_below="@id/radioGroupCategories"
        android:layout_marginTop="@dimen/margin_large"
        android:backgroundTint="@color/modern_primary"
        android:text="@string/fetch_data"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_body_large"
        android:fontFamily="@font/bold"
        app:cornerRadius="@dimen/radius_medium" />

    <!-- Loading Progress -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_centerInParent="true"
        android:indeterminateTint="@color/modern_primary"
        android:visibility="gone" />

</RelativeLayout>