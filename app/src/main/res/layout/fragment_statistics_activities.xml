<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".fragments.StatisticsActivitiesFragment">

    <!-- Background -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_background" />

    <!-- Ambient Blobs -->
    <ImageView
        android:id="@+id/bg_blob_1"
        android:layout_width="@dimen/blob_size_1"
        android:layout_height="@dimen/blob_size_1"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:alpha="0.08"
        android:src="@drawable/bg_blob_1"
        android:contentDescription="@string/blank" />

    <ImageView
        android:id="@+id/bg_blob_2"
        android:layout_width="@dimen/blob_size_2"
        android:layout_height="@dimen/blob_size_2"
        android:alpha="0.08"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:src="@drawable/bg_blob_2"
        android:contentDescription="@string/blank" />

    <!-- Header Section -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/headerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_screen"
        app:cardCornerRadius="@dimen/radius_xlarge"
        app:cardElevation="@dimen/elevation_floating"
        app:strokeWidth="@dimen/stroke_thin"
        app:strokeColor="@color/border_gray"
        app:cardBackgroundColor="@color/surface">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/padding_medium">

            <!-- Back Button -->
            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="@dimen/icon_button_size"
                android:layout_height="@dimen/icon_button_size"
                android:src="@drawable/ic_back"
                android:background="@drawable/rounded_button_background_secondary"
                app:tint="@color/modern_primary"
                android:scaleType="centerInside"
                android:contentDescription="@string/cd_flip_back" />

            <!-- Activity Name -->
            <TextView
                android:id="@+id/intentActivityView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/backButton"
                android:layout_toStartOf="@id/refreshButton"
                android:layout_centerVertical="true"
                android:layout_marginHorizontal="@dimen/margin_medium"
                android:gravity="center"
                android:text="Activity Statistics"
                android:textSize="@dimen/text_size_title"
                android:fontFamily="@font/bold"
                android:textColor="@color/textPrimary"
                android:letterSpacing="0.01" />

            <!-- Refresh Button -->
            <ImageButton
                android:id="@+id/refreshButton"
                android:layout_width="@dimen/icon_button_size"
                android:layout_height="@dimen/icon_button_size"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_reset"
                android:background="@drawable/rounded_button_background_secondary"
                app:tint="@color/modern_primary"
                android:scaleType="centerInside"
                android:contentDescription="Refresh statistics" />

        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Main Content Layout -->
    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerCard"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Statistics Container -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/margin_screen"
            android:layout_marginBottom="@dimen/margin_screen"
            app:cardCornerRadius="@dimen/radius_xlarge"
            app:cardElevation="@dimen/elevation_card"
            app:strokeWidth="@dimen/stroke_thin"
            app:strokeColor="@color/border_gray"
            app:cardBackgroundColor="@color/surface">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/padding_large"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Row: Last Session & Today -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/margin_small">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/stat_item_background"
                            android:padding="@dimen/padding_medium"
                            android:layout_marginEnd="@dimen/margin_tiny">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Last Session"
                                android:textSize="@dimen/text_size_caption"
                                android:textColor="@color/textSecondary"
                                android:fontFamily="@font/robotomedium"
                                android:letterSpacing="0.02" />

                            <TextView
                                android:id="@+id/lastSessionTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/timer_default_value"
                                android:textSize="@dimen/text_size_title"
                                android:textColor="@color/statusSuccess"
                                android:fontFamily="@font/bold"
                                android:layout_marginTop="@dimen/margin_micro" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/stat_item_background"
                            android:padding="@dimen/padding_medium"
                            android:layout_marginStart="@dimen/margin_tiny">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Today"
                                android:textSize="@dimen/text_size_caption"
                                android:textColor="@color/textSecondary"
                                android:fontFamily="@font/robotomedium"
                                android:letterSpacing="0.02" />

                            <TextView
                                android:id="@+id/todayTimeTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/timer_default_value"
                                android:textSize="@dimen/text_size_title"
                                android:textColor="@color/modern_primary"
                                android:fontFamily="@font/bold"
                                android:layout_marginTop="@dimen/margin_micro" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Total Sessions Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/stat_item_background"
                        android:padding="@dimen/padding_medium"
                        android:layout_marginBottom="@dimen/margin_small">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_count_sessions"
                            android:textSize="@dimen/text_size_caption"
                            android:textColor="@color/textSecondary"
                            android:fontFamily="@font/robotomedium"
                            android:letterSpacing="0.02" />

                        <TextView
                            android:id="@+id/totalSessionsTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="@dimen/text_size_title"
                            android:textColor="@color/textPrimary"
                            android:fontFamily="@font/bold"
                            android:layout_marginTop="@dimen/margin_micro" />

                    </LinearLayout>

                    <!-- Stats Grid - Start & End Time -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/margin_small">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/stat_item_background"
                            android:padding="@dimen/padding_medium"
                            android:layout_marginEnd="@dimen/margin_tiny">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_start_time"
                                android:textSize="@dimen/text_size_caption"
                                android:textColor="@color/textSecondary"
                                android:fontFamily="@font/robotomedium"
                                android:letterSpacing="0.02" />

                            <TextView
                                android:id="@+id/sTimeTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/default_empty_value"
                                android:textSize="@dimen/text_size_body"
                                android:textColor="@color/textPrimary"
                                android:fontFamily="@font/bold"
                                android:maxLines="1"
                                android:ellipsize="end" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/stat_item_background"
                            android:padding="@dimen/padding_medium"
                            android:layout_marginStart="@dimen/margin_tiny">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_end_time"
                                android:textSize="@dimen/text_size_caption"
                                android:textColor="@color/textSecondary"
                                android:fontFamily="@font/robotomedium"
                                android:letterSpacing="0.02" />

                            <TextView
                                android:id="@+id/endTimeTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/default_empty_value"
                                android:textSize="@dimen/text_size_body"
                                android:textColor="@color/textPrimary"
                                android:fontFamily="@font/bold"
                                android:maxLines="1"
                                android:ellipsize="end" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Stats Grid - Total Time & Sessions Count -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/margin_small">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/stat_item_background"
                            android:padding="@dimen/padding_medium"
                            android:layout_marginEnd="@dimen/margin_tiny">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_total_spent_time"
                                android:textSize="@dimen/text_size_caption"
                                android:textColor="@color/textSecondary"
                                android:fontFamily="@font/robotomedium"
                                android:letterSpacing="0.02" />

                            <TextView
                                android:id="@+id/totalTimeTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/timer_default_value"
                                android:textSize="@dimen/text_size_body"
                                android:textColor="@color/textPrimary"
                                android:fontFamily="@font/bold" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/stat_item_background"
                            android:padding="@dimen/padding_medium"
                            android:layout_marginStart="@dimen/margin_tiny">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_count_sessions"
                                android:textSize="@dimen/text_size_caption"
                                android:textColor="@color/textSecondary"
                                android:fontFamily="@font/robotomedium"
                                android:letterSpacing="0.02" />

                            <TextView
                                android:id="@+id/countTimeTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="@dimen/text_size_body"
                                android:textColor="@color/textPrimary"
                                android:fontFamily="@font/bold" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Stats Grid - Mean & Median -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/margin_small">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/stat_item_background"
                            android:padding="@dimen/padding_medium"
                            android:layout_marginEnd="@dimen/margin_tiny">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_mean_time"
                                android:textSize="@dimen/text_size_caption"
                                android:textColor="@color/textSecondary"
                                android:fontFamily="@font/robotomedium"
                                android:letterSpacing="0.02" />

                            <TextView
                                android:id="@+id/meanTimeTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/timer_default_value"
                                android:textSize="@dimen/text_size_body"
                                android:textColor="@color/textPrimary"
                                android:fontFamily="@font/bold" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/stat_item_background"
                            android:padding="@dimen/padding_medium"
                            android:layout_marginStart="@dimen/margin_tiny">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_median_time"
                                android:textSize="@dimen/text_size_caption"
                                android:textColor="@color/textSecondary"
                                android:fontFamily="@font/robotomedium"
                                android:letterSpacing="0.02" />

                            <TextView
                                android:id="@+id/medianTimeTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/timer_default_value"
                                android:textSize="@dimen/text_size_body"
                                android:textColor="@color/textPrimary"
                                android:fontFamily="@font/bold" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Stats Grid - Max & Min Time -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/margin_small">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/stat_item_background"
                            android:padding="@dimen/padding_medium"
                            android:layout_marginEnd="@dimen/margin_tiny">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_maximum_time"
                                android:textSize="@dimen/text_size_caption"
                                android:textColor="@color/textSecondary"
                                android:fontFamily="@font/robotomedium"
                                android:letterSpacing="0.02" />

                            <TextView
                                android:id="@+id/maximumTimeTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/timer_default_value"
                                android:textSize="@dimen/text_size_body"
                                android:textColor="@color/textPrimary"
                                android:fontFamily="@font/bold" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/stat_item_background"
                            android:padding="@dimen/padding_medium"
                            android:layout_marginStart="@dimen/margin_tiny">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_minimum_time"
                                android:textSize="@dimen/text_size_caption"
                                android:textColor="@color/textSecondary"
                                android:fontFamily="@font/robotomedium"
                                android:letterSpacing="0.02" />

                            <TextView
                                android:id="@+id/minimumTimeTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/timer_default_value"
                                android:textSize="@dimen/text_size_body"
                                android:textColor="@color/textPrimary"
                                android:fontFamily="@font/bold" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Pause Time -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/stat_item_background"
                        android:padding="@dimen/padding_medium">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Last Pause"
                            android:textSize="@dimen/text_size_caption"
                            android:textColor="@color/textSecondary"
                            android:fontFamily="@font/robotomedium"
                            android:letterSpacing="0.02" />

                        <TextView
                            android:id="@+id/pauseTimeTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/default_empty_value"
                            android:textSize="@dimen/text_size_body"
                            android:textColor="@color/textPrimary"
                            android:fontFamily="@font/bold"
                            android:maxLines="1"
                            android:ellipsize="end" />

                    </LinearLayout>

                </LinearLayout>

            </ScrollView>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Loading Progress -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:indeterminateTint="@color/modern_primary"
        android:visibility="gone" />

</RelativeLayout>