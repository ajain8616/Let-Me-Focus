<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white"
    android:theme="@style/Base.Theme.ActivityTracker"
    tools:context=".SignUpFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/margin_xlarge"
        android:paddingTop="@dimen/margin_header"
        android:paddingBottom="@dimen/margin_xlarge"
        android:gravity="center_horizontal">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/margin_xxlarge">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/signup_title"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/text_size_hero"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_tiny"
                android:text="@string/signup_subtitle"
                android:textColor="@color/lavender"
                android:textSize="@dimen/text_size_body_large"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Full Name Input -->
        <EditText
            android:id="@+id/userName"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_field_height"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="@dimen/padding_large"
            android:hint="@string/hint_name"
            android:textColorHint="@color/light_gray"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_body_large"
            android:inputType="textPersonName|textCapWords"
            android:imeOptions="actionNext"
            android:autofillHints="name"
            android:importantForAutofill="yes"
            android:maxLines="1" />

        <!-- Email Input -->
        <EditText
            android:id="@+id/userEmail"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_field_height"
            android:layout_marginTop="@dimen/margin_medium"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="@dimen/padding_large"
            android:hint="@string/hint_email"
            android:textColorHint="@color/light_gray"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_body_large"
            android:inputType="textEmailAddress"
            android:imeOptions="actionNext"
            android:autofillHints="emailAddress"
            android:importantForAutofill="yes"
            android:maxLines="1" />

        <!-- Password Input -->
        <EditText
            android:id="@+id/userPassword"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_field_height"
            android:layout_marginTop="@dimen/margin_medium"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="@dimen/padding_large"
            android:hint="@string/hint_password"
            android:textColorHint="@color/light_gray"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_body_large"
            android:inputType="textPassword"
            android:imeOptions="actionNext"
            android:autofillHints="newPassword"
            android:importantForAutofill="yes"
            android:maxLines="1" />

        <!-- Confirm Password Input -->
        <EditText
            android:id="@+id/confirmUserPassword"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_field_height"
            android:layout_marginTop="@dimen/margin_medium"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="@dimen/padding_large"
            android:hint="@string/hint_confirm_password"
            android:textColorHint="@color/light_gray"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_body_large"
            android:inputType="textPassword"
            android:imeOptions="actionDone"
            android:autofillHints="newPassword"
            android:importantForAutofill="yes"
            android:maxLines="1" />

        <!-- Sign Up Button -->
        <Button
            android:id="@+id/signup_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/margin_xlarge"
            android:background="@drawable/bg_primary_button"
            android:text="@string/action_sign_up"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_subheading"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            android:elevation="@dimen/card_elevation" />

        <!-- Flexible Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/margin_xlarge" />

        <!-- Login Prompt -->
        <TextView
            android:id="@+id/login_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_large"
            android:padding="@dimen/padding_standard"
            android:text="@string/prompt_have_account"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/text_size_body_large"
            android:fontFamily="sans-serif-medium"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</ScrollView>