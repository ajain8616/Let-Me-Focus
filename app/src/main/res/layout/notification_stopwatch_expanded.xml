<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/notificationRootExpanded"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/notification_container_bg"
    android:padding="@dimen/padding_large">

    <!-- Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_small">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivHeaderIcon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:contentDescription="@string/app_name" />

            <TextView
                android:id="@+id/tvHeaderApp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/modern_secondary"
                android:textSize="@dimen/text_size_caption"
                android:fontFamily="@font/bold"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <!-- Status Tag (Switches between Active & Paused) -->
        <TextView
            android:id="@+id/tvStatusTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/notification_badge_active"
            android:paddingHorizontal="@dimen/padding_standard"
            android:paddingVertical="@dimen/padding_micro"
            android:text="● ACTIVE"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_caption"
            android:fontFamily="@font/bold" />
    </RelativeLayout>

    <!-- Main Content Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginVertical="@dimen/margin_tiny">

        <!-- Activity Name & Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvExpandedActivityName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/activity_name"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_title"
                android:fontFamily="@font/bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvSessionSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Session in progress"
                android:textColor="@color/textHint"
                android:textSize="@dimen/text_size_caption"
                android:fontFamily="@font/robotoregular" />
        </LinearLayout>

        <!-- Large Timer Display -->
        <TextView
            android:id="@+id/tvExpandedTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/timer_default_value"
            android:textColor="@color/modern_secondary"
            android:textSize="@dimen/text_size_display"
            android:fontFamily="@font/bold"
            android:letterSpacing="0.04" />
    </LinearLayout>

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="@dimen/margin_medium">

        <!-- Pause / Resume Action -->
        <LinearLayout
            android:id="@+id/btnExpandedPauseResume"
            android:layout_width="0dp"
            android:layout_height="@dimen/icon_button_size"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/margin_tiny"
            android:background="@drawable/notification_action_btn_bg"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivExpandedPauseResumeIcon"
                android:layout_width="@dimen/icon_size_standard"
                android:layout_height="@dimen/icon_size_standard"
                android:src="@drawable/ic_pause"
                app:tint="@color/modern_secondary"
                android:contentDescription="@string/pause" />

            <TextView
                android:id="@+id/tvExpandedPauseResumeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small"
                android:text="@string/pause"
                android:textColor="@color/modern_secondary"
                android:textSize="@dimen/text_size_body_small"
                android:fontFamily="@font/bold" />
        </LinearLayout>

        <!-- Stop & Save Action -->
        <LinearLayout
            android:id="@+id/btnExpandedStop"
            android:layout_width="0dp"
            android:layout_height="@dimen/icon_button_size"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/margin_tiny"
            android:background="@drawable/notification_action_btn_bg"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/icon_size_standard"
                android:layout_height="@dimen/icon_size_standard"
                android:src="@drawable/ic_stop"
                app:tint="@color/error"
                android:contentDescription="@string/stop" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small"
                android:text="Stop &amp; Save"
                android:textColor="@color/error"
                android:textSize="@dimen/text_size_body_small"
                android:fontFamily="@font/bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>