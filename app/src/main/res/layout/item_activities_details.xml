<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/margin_large"
    android:layout_marginVertical="@dimen/margin_standard"
    android:theme="@style/Base.Theme.ActivityTracker"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation"
    app:cardBackgroundColor="@color/white"
    app:cardUseCompatPadding="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_large">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Activity Name Header -->
            <TextView
                android:id="@+id/activityNameTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:textSize="@dimen/text_size_heading"
                android:textColor="@color/black"
                android:gravity="center"
                android:paddingBottom="@dimen/padding_standard"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/hint_activity_name" />

            <!-- Clean Subtle Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:background="@color/dividerColor"
                android:layout_marginTop="@dimen/margin_tiny"
                android:layout_marginBottom="@dimen/margin_large" />

            <!-- Creation Time Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/margin_medium">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_creation_time"
                    android:textSize="@dimen/text_size_body"
                    android:textColor="@color/light_gray"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginEnd="@dimen/margin_standard" />

                <TextView
                    android:id="@+id/creationTimeTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="@dimen/text_size_body"
                    android:textColor="@color/black"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="end"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/default_empty_value" />

            </LinearLayout>

            <!-- Status Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/margin_medium">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_status"
                    android:textSize="@dimen/text_size_body"
                    android:textColor="@color/light_gray"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginEnd="@dimen/margin_standard" />

                <TextView
                    android:id="@+id/statusTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="@dimen/text_size_body"
                    android:textColor="@color/green"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="end"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/default_empty_value" />

            </LinearLayout>

            <!-- Total Spent Time Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_total_spent_time"
                    android:textSize="@dimen/text_size_body"
                    android:textColor="@color/light_gray"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginEnd="@dimen/margin_standard" />

                <TextView
                    android:id="@+id/totalSpentTimeTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="@dimen/text_size_body"
                    android:textColor="@color/colorRoyalBlue"
                    android:fontFamily="sans-serif-black"
                    android:gravity="end"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/default_empty_value" />

            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

</androidx.cardview.widget.CardView>