<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/margin_small"
    android:layout_marginVertical="@dimen/margin_tiny"
    app:cardCornerRadius="@dimen/radius_large"
    app:cardElevation="@dimen/elevation_card"
    app:strokeWidth="@dimen/stroke_thin"
    app:strokeColor="@color/border_gray"
    app:cardBackgroundColor="@color/surface">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_gradient_background"
        android:paddingHorizontal="@dimen/padding_screen"
        android:paddingVertical="@dimen/padding_medium">

        <!-- Activity Header -->
        <RelativeLayout
            android:id="@+id/activityHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_small">

            <TextView
                android:id="@+id/activityNameTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/statusIndicator"
                android:layout_marginEnd="@dimen/margin_medium"
                android:layout_centerVertical="true"
                android:text="@string/activity_name"
                android:textSize="@dimen/text_size_heading"
                android:fontFamily="@font/bold"
                android:textColor="@color/textPrimary"
                android:letterSpacing="0.01"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Live Status Indicator -->
            <View
                android:id="@+id/statusIndicator"
                android:layout_width="@dimen/margin_standard"
                android:layout_height="@dimen/margin_standard"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/status_indicator_active" />

        </RelativeLayout>

        <!-- Stats Grid (4 Rows) -->
        <LinearLayout
            android:id="@+id/statsGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/activityHeader"
            android:orientation="vertical">

            <!-- Row 1: Creation Time & Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/margin_tiny">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/stat_item_background"
                    android:paddingVertical="@dimen/padding_small"
                    android:paddingHorizontal="@dimen/padding_medium"
                    android:layout_marginEnd="@dimen/margin_tiny">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Created"
                        android:textSize="@dimen/text_size_caption"
                        android:textColor="@color/textSecondary"
                        android:fontFamily="@font/robotomedium"
                        android:letterSpacing="0.02" />

                    <TextView
                        android:id="@+id/creationTimeTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_empty_value"
                        android:textSize="@dimen/text_size_body_small"
                        android:textColor="@color/textPrimary"
                        android:fontFamily="@font/bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/stat_item_background"
                    android:paddingVertical="@dimen/padding_small"
                    android:paddingHorizontal="@dimen/padding_medium"
                    android:layout_marginStart="@dimen/margin_tiny">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status"
                        android:textSize="@dimen/text_size_caption"
                        android:textColor="@color/textSecondary"
                        android:fontFamily="@font/robotomedium"
                        android:letterSpacing="0.02" />

                    <TextView
                        android:id="@+id/statusTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/active"
                        android:textSize="@dimen/text_size_body_small"
                        android:textColor="@color/statusSuccess"
                        android:fontFamily="@font/bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- Row 2: Total Spent Time & Sessions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/margin_tiny">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/stat_item_background"
                    android:paddingVertical="@dimen/padding_small"
                    android:paddingHorizontal="@dimen/padding_medium"
                    android:layout_marginEnd="@dimen/margin_tiny">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_total_spent_time"
                        android:textSize="@dimen/text_size_caption"
                        android:textColor="@color/textSecondary"
                        android:fontFamily="@font/robotomedium"
                        android:letterSpacing="0.02" />

                    <TextView
                        android:id="@+id/totalSpentTimeTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/timer_default_value"
                        android:textSize="@dimen/text_size_body_small"
                        android:textColor="@color/modern_primary"
                        android:fontFamily="@font/bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/stat_item_background"
                    android:paddingVertical="@dimen/padding_small"
                    android:paddingHorizontal="@dimen/padding_medium"
                    android:layout_marginStart="@dimen/margin_tiny">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_count_sessions"
                        android:textSize="@dimen/text_size_caption"
                        android:textColor="@color/textSecondary"
                        android:fontFamily="@font/robotomedium"
                        android:letterSpacing="0.02" />

                    <TextView
                        android:id="@+id/sessionsTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="@dimen/text_size_body_small"
                        android:textColor="@color/textPrimary"
                        android:fontFamily="@font/bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- Row 3: Last Session & Average Time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/margin_tiny">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/stat_item_background"
                    android:paddingVertical="@dimen/padding_small"
                    android:paddingHorizontal="@dimen/padding_medium"
                    android:layout_marginEnd="@dimen/margin_tiny">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Last Session"
                        android:textSize="@dimen/text_size_caption"
                        android:textColor="@color/textSecondary"
                        android:fontFamily="@font/robotomedium"
                        android:letterSpacing="0.02" />

                    <TextView
                        android:id="@+id/lastSessionTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/timer_default_value"
                        android:textSize="@dimen/text_size_body_small"
                        android:textColor="@color/textPrimary"
                        android:fontFamily="@font/bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/stat_item_background"
                    android:paddingVertical="@dimen/padding_small"
                    android:paddingHorizontal="@dimen/padding_medium"
                    android:layout_marginStart="@dimen/margin_tiny">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_mean_time"
                        android:textSize="@dimen/text_size_caption"
                        android:textColor="@color/textSecondary"
                        android:fontFamily="@font/robotomedium"
                        android:letterSpacing="0.02" />

                    <TextView
                        android:id="@+id/averageTimeTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/timer_default_value"
                        android:textSize="@dimen/text_size_body_small"
                        android:textColor="@color/textPrimary"
                        android:fontFamily="@font/bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- Row 4: Today's Total Time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/stat_item_background"
                    android:paddingVertical="@dimen/padding_small"
                    android:paddingHorizontal="@dimen/padding_medium">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Today's Total Time"
                        android:textSize="@dimen/text_size_caption"
                        android:textColor="@color/textSecondary"
                        android:fontFamily="@font/robotomedium"
                        android:letterSpacing="0.02" />

                    <TextView
                        android:id="@+id/todayTimeTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/timer_default_value"
                        android:textSize="@dimen/text_size_body_small"
                        android:textColor="@color/modern_primary"
                        android:fontFamily="@font/bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>