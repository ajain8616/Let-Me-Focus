<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true">

    <!-- Gradient background applied here -->
    <RelativeLayout
        android:id="@+id/main_CardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_background"
        android:padding="20dp">

        <!-- FRONT SIDE -->
        <LinearLayout
            android:id="@+id/card_front"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/activityNameTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@id/closeButton"
                    android:layout_marginEnd="12dp"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary"
                    android:gravity="start"
                    android:hint="@string/activity_name"
                    android:letterSpacing="0.02"
                    android:lineHeight="28sp" />

                <ImageButton
                    android:id="@+id/closeButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/ic_clear"
                    android:background="@drawable/rounded_button_error"
                    android:tint="@color/white"
                    android:scaleType="centerInside"
                    android:padding="6dp" />
            </RelativeLayout>

            <!-- Stopwatch Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/stopwatch_background"
                android:paddingVertical="16dp"
                android:paddingHorizontal="20dp"
                android:layout_marginTop="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_stopwatch"
                    android:tint="@color/modern_primary"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/stopwatchTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="24sp"
                    android:textColor="@color/modern_primary"
                    android:gravity="start"
                    android:text="00:00:00"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.05" />

                <View
                    android:id="@+id/statusIndicator"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/status_indicator_active"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Quick Actions - 3 Buttons Layout -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp">

                <!-- Play/Pause Button -->
                <ImageButton
                    android:id="@+id/playPauseButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_play"
                    android:background="@drawable/rounded_button_outline_green"
                    android:tint="@color/success_dark"
                    android:scaleType="centerInside"
                    android:padding="8dp" />

                <!-- Stop Button -->
                <ImageButton
                    android:id="@+id/stopButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_stop"
                    android:background="@drawable/rounded_button_outline_red"
                    android:tint="@color/error"
                    android:scaleType="centerInside"
                    android:padding="8dp"
                    android:visibility="gone" />

                <!-- Flip Button -->
                <ImageButton
                    android:id="@+id/flipButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_flip"
                    android:background="@drawable/rounded_button_outline_primary"
                    android:tint="@color/modern_primary"
                    android:scaleType="centerInside"
                    android:padding="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- BACK SIDE -->
        <LinearLayout
            android:id="@+id/card_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="16px">

                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_back"
                    android:background="@drawable/rounded_button_background_primary"
                    android:tint="@color/white"
                    android:scaleType="centerInside"
                    android:padding="6dp" />

                <TextView
                    android:id="@+id/activityNameTextView1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/backButton"
                    android:layout_marginStart="16dp"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary"
                    android:gravity="center"
                    android:hint="@string/activity_name"
                    android:letterSpacing="0.02" />
            </RelativeLayout>

            <!-- Stats Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/stat_item_background"
                        android:padding="12dp"
                        android:layout_marginEnd="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Time"
                            android:textSize="12sp"
                            android:textColor="@color/textSecondary"
                            android:letterSpacing="0.02" />

                        <TextView
                            android:id="@+id/backTextView1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00:00"
                            android:textSize="16sp"
                            android:textColor="@color/textPrimary"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/stat_item_background"
                        android:padding="12dp"
                        android:layout_marginStart="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sessions"
                            android:textSize="12sp"
                            android:textColor="@color/textSecondary"
                            android:letterSpacing="0.02" />

                        <TextView
                            android:id="@+id/backTextView2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="16sp"
                            android:textColor="@color/textPrimary"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/stat_item_background"
                        android:padding="12dp"
                        android:layout_marginEnd="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Average Time"
                            android:textSize="12sp"
                            android:textColor="@color/textSecondary"
                            android:letterSpacing="0.02" />

                        <TextView
                            android:id="@+id/backTextView3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00:00"
                            android:textSize="16sp"
                            android:textColor="@color/textPrimary"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/stat_item_background"
                        android:padding="12dp"
                        android:layout_marginStart="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Last Session"
                            android:textSize="12sp"
                            android:textColor="@color/textSecondary"
                            android:letterSpacing="0.02" />

                        <TextView
                            android:id="@+id/backTextView4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00:00"
                            android:textSize="16sp"
                            android:textColor="@color/textPrimary"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Bottom Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/resetButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_reset"
                    android:background="@drawable/rounded_button_background_transparent"
                    android:tint="@color/error"
                    android:scaleType="centerInside"
                    android:padding="8dp" />

                <!-- Share Button -->
                <ImageButton
                    android:id="@+id/shareButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_share"
                    android:background="@drawable/rounded_button_background_transparent"
                    android:tint="@color/modern_primary"
                    android:scaleType="centerInside"
                    android:padding="8dp" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>