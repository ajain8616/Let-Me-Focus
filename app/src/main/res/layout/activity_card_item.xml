<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/margin_small"
    android:layout_marginVertical="@dimen/margin_tiny"
    app:cardCornerRadius="@dimen/radius_large"
    app:cardElevation="@dimen/elevation_card"
    app:strokeWidth="@dimen/stroke_thin"
    app:strokeColor="@color/border_gray"
    app:cardBackgroundColor="@color/surface">

    <RelativeLayout
        android:id="@+id/main_CardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="215dp"
        android:background="@drawable/card_gradient_background"
        android:paddingHorizontal="@dimen/padding_screen"
        android:paddingVertical="@dimen/padding_medium">

        <!-- ============================================================= -->
        <!-- FRONT SIDE: Hero Live Tracking & Tactile Action Controls      -->
        <!-- ============================================================= -->
        <LinearLayout
            android:id="@+id/card_front"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card Header: Title & Circular Close Button -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_small">

                <TextView
                    android:id="@+id/activityNameTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@id/closeButton"
                    android:layout_marginEnd="@dimen/margin_medium"
                    android:layout_centerVertical="true"
                    android:textSize="@dimen/text_size_heading"
                    android:fontFamily="@font/bold"
                    android:textColor="@color/textPrimary"
                    android:hint="@string/activity_name"
                    android:textColorHint="@color/textHint"
                    android:letterSpacing="0.01"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Circular Red Background Close Button -->
                <ImageButton
                    android:id="@+id/closeButton"
                    android:layout_width="@dimen/icon_size_large"
                    android:layout_height="@dimen/icon_size_large"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_clear"
                    android:background="@drawable/rounded_button_error"
                    app:tint="@color/white"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/cd_close_activity"
                    android:padding="@dimen/padding_tiny" />
            </RelativeLayout>

            <!-- Stopwatch Hero Timer Capsule -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/stopwatch_background"
                android:paddingHorizontal="@dimen/padding_large"
                android:layout_marginBottom="@dimen/margin_standard">

                <ImageView
                    android:layout_width="@dimen/icon_size_standard"
                    android:layout_height="@dimen/icon_size_standard"
                    android:src="@drawable/ic_stopwatch"
                    app:tint="@color/modern_primary"
                    android:contentDescription="@string/app_name"
                    android:layout_marginEnd="@dimen/margin_medium" />

                <!-- Formatted Live Timer -->
                <TextView
                    android:id="@+id/stopwatchTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="@dimen/text_size_hero"
                    android:textColor="@color/modern_primary"
                    android:gravity="start|center_vertical"
                    android:text="@string/timer_default_value"
                    android:fontFamily="@font/bold"
                    android:letterSpacing="0.02" />

                <!-- Live Status Indicator Dot -->
                <View
                    android:id="@+id/statusIndicator"
                    android:layout_width="@dimen/margin_standard"
                    android:layout_height="@dimen/margin_standard"
                    android:background="@drawable/status_indicator_active"
                    android:layout_marginStart="@dimen/margin_small" />
            </LinearLayout>

            <!-- Quick Action Controls Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Play / Pause Action Button -->
                <ImageButton
                    android:id="@+id/playPauseButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/margin_tiny"
                    android:src="@drawable/ic_play"
                    android:background="@drawable/rounded_button_outline_green"
                    app:tint="@color/statusSuccess"
                    android:contentDescription="@string/active"
                    android:scaleType="centerInside"
                    android:padding="@dimen/padding_standard" />

                <!-- Stop & Save Action Button -->
                <ImageButton
                    android:id="@+id/stopButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="@dimen/margin_tiny"
                    android:src="@drawable/ic_stop"
                    android:background="@drawable/rounded_button_outline_red"
                    app:tint="@color/error"
                    android:contentDescription="@string/stop"
                    android:scaleType="centerInside"
                    android:padding="@dimen/padding_standard"
                    android:visibility="gone" />

                <!-- Flip to Statistics Button -->
                <ImageButton
                    android:id="@+id/flipButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/margin_tiny"
                    android:src="@drawable/ic_flip"
                    android:background="@drawable/rounded_button_outline_primary"
                    app:tint="@color/modern_primary"
                    android:contentDescription="@string/cd_flip_back"
                    android:scaleType="centerInside"
                    android:padding="@dimen/padding_standard" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================================================= -->
        <!-- BACK SIDE: Detailed Activity Analytics & History               -->
        <!-- ============================================================= -->
        <LinearLayout
            android:id="@+id/card_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Card Back Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_small">
                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:background="@drawable/rounded_button_outline_primary"
                    app:srcCompat="@drawable/ic_back"
                    app:tint="@color/modern_primary"
                    android:scaleType="centerInside"
                    android:padding="@dimen/padding_small"
                    android:contentDescription="@string/cd_flip_back" />

                <TextView
                    android:id="@+id/activityNameTextView1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/backButton"
                    android:layout_marginStart="@dimen/margin_medium"
                    android:layout_centerVertical="true"
                    android:textSize="@dimen/text_size_heading"
                    android:fontFamily="@font/bold"
                    android:textColor="@color/textPrimary"
                    android:hint="@string/title_activities_details"
                    android:textColorHint="@color/textHint"
                    android:letterSpacing="0.01"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </RelativeLayout>

            <!-- 2x2 Analytics Tiles Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/margin_standard">

                <!-- Metric Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/margin_tiny">

                    <!-- Total Time Metric -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/margin_tiny"
                        app:cardCornerRadius="@dimen/radius_medium"
                        app:cardElevation="@dimen/elevation_flat"
                        app:strokeWidth="@dimen/stroke_thin"
                        app:strokeColor="@color/border_gray"
                        app:cardBackgroundColor="@color/surface_container">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingVertical="@dimen/padding_small"
                            android:paddingHorizontal="@dimen/padding_medium">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_total_spent_time"
                                android:textSize="@dimen/text_size_caption"
                                android:textColor="@color/textSecondary"
                                android:fontFamily="@font/robotomedium"
                                android:letterSpacing="0.02" />

                            <TextView
                                android:id="@+id/backTextView1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/timer_default_value"
                                android:textSize="@dimen/text_size_subheading"
                                android:textColor="@color/modern_primary"
                                android:fontFamily="@font/bold"
                                android:layout_marginTop="@dimen/margin_micro" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Total Sessions Metric -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/margin_tiny"
                        app:cardCornerRadius="@dimen/radius_medium"
                        app:cardElevation="@dimen/elevation_flat"
                        app:strokeWidth="@dimen/stroke_thin"
                        app:strokeColor="@color/border_gray"
                        app:cardBackgroundColor="@color/surface_container">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingVertical="@dimen/padding_small"
                            android:paddingHorizontal="@dimen/padding_medium">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_count_sessions"
                                android:textSize="@dimen/text_size_caption"
                                android:textColor="@color/textSecondary"
                                android:fontFamily="@font/robotomedium"
                                android:letterSpacing="0.02" />

                            <TextView
                                android:id="@+id/backTextView2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="@dimen/text_size_subheading"
                                android:textColor="@color/textPrimary"
                                android:fontFamily="@font/bold"
                                android:layout_marginTop="@dimen/margin_micro" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Metric Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Average Duration Metric -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/margin_tiny"
                        app:cardCornerRadius="@dimen/radius_medium"
                        app:cardElevation="@dimen/elevation_flat"
                        app:strokeWidth="@dimen/stroke_thin"
                        app:strokeColor="@color/border_gray"
                        app:cardBackgroundColor="@color/surface_container">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingVertical="@dimen/padding_small"
                            android:paddingHorizontal="@dimen/padding_medium">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_mean_time"
                                android:textSize="@dimen/text_size_caption"
                                android:textColor="@color/textSecondary"
                                android:fontFamily="@font/robotomedium"
                                android:letterSpacing="0.02" />

                            <TextView
                                android:id="@+id/backTextView3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/timer_default_value"
                                android:textSize="@dimen/text_size_subheading"
                                android:textColor="@color/modern_primary"
                                android:fontFamily="@font/bold"
                                android:layout_marginTop="@dimen/margin_micro" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Last Session End Time Metric -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/margin_tiny"
                        app:cardCornerRadius="@dimen/radius_medium"
                        app:cardElevation="@dimen/elevation_flat"
                        app:strokeWidth="@dimen/stroke_thin"
                        app:strokeColor="@color/border_gray"
                        app:cardBackgroundColor="@color/surface_container">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingVertical="@dimen/padding_small"
                            android:paddingHorizontal="@dimen/padding_medium">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_end_time"
                                android:textSize="@dimen/text_size_caption"
                                android:textColor="@color/textSecondary"
                                android:fontFamily="@font/robotomedium"
                                android:letterSpacing="0.02" />

                            <TextView
                                android:id="@+id/backTextView4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/timer_default_value"
                                android:textSize="@dimen/text_size_subheading"
                                android:textColor="@color/textPrimary"
                                android:fontFamily="@font/bold"
                                android:layout_marginTop="@dimen/margin_micro" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <!-- Reset Action Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Reset Statistics Button -->
                <ImageButton
                    android:id="@+id/resetButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_reset"
                    android:background="@drawable/rounded_button_outline_red"
                    app:tint="@color/error"
                    android:contentDescription="@string/stop"
                    android:scaleType="centerInside"
                    android:padding="@dimen/padding_standard" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>