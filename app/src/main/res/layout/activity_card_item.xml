<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    android:theme="@style/Base.Theme.ActivityTracker"
    android:layout_margin="16dp">

    <RelativeLayout
        android:id="@+id/main_CardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Front Side of Card -->
        <LinearLayout
            android:id="@+id/card_front"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <!-- Activity Name -->
                <TextView
                    android:id="@+id/activityNameTextView"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimary"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:hint="@string/activity_name" />

                <!-- Close Button -->
                <ImageButton
                    android:id="@+id/closeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_clear"
                    android:background="?android:attr/selectableItemBackground"
                    app:tint="@color/colorAccent" />

            </LinearLayout>

            <!-- Stopwatch -->
            <TextView
                android:id="@+id/stopwatchTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="30sp"
                android:textColor="@color/colorAccent"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:gravity="center"
            android:text="00:00:00" />

        </LinearLayout>

        <!-- Back Side of Card -->
        <LinearLayout
            android:id="@+id/card_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingTop="8dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <!-- Back Button -->
                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_back"
                    android:background="?android:attr/selectableItemBackground"
                    app:tint="@color/colorAccent" />

                <!-- Activity Name -->
                <TextView
                    android:id="@+id/activityNameTextView1"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimary"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:hint="@string/activity_name" />

            </LinearLayout>

            <!-- Additional details -->
            <TextView
                android:id="@+id/backTextView1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/blank"
                android:textSize="18sp"
                android:textColor="@color/colorSecondary"
            android:padding="8dp" />

            <TextView
                android:id="@+id/backTextView2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/blank"
                android:textSize="18sp"
                android:textColor="@color/colorSecondary"
            android:padding="8dp" />

            <TextView
                android:id="@+id/backTextView3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/blank"
                android:visibility="gone"
                android:textSize="18sp"
                android:textColor="@color/colorSecondary"
            android:padding="8dp" />

        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>