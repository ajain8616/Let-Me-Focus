<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="9dp"
    app:cardUseCompatPadding="true">

    <RelativeLayout
        android:id="@+id/main_CardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_gradient_background"
        android:padding="16dp">

        <!-- FRONT SIDE -->
        <LinearLayout
            android:id="@+id/card_front"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header Section -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/activityNameTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@id/closeButton"
                    android:layout_marginEnd="8dp"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary"
                    android:gravity="center"
                    android:hint="Activity Name"
                    android:letterSpacing="0.01"
                    android:lineHeight="22sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <ImageButton
                    android:id="@+id/closeButton"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/ic_clear"
                    android:background="@drawable/rounded_button_error"
                    android:tint="@color/white"
                    android:scaleType="centerInside"
                    android:padding="4dp" />
            </RelativeLayout>

            <!-- Stopwatch Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/stopwatch_background"
                android:paddingVertical="12dp"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_stopwatch"
                    android:tint="@color/modern_primary"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/stopwatchTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="18sp"
                    android:textColor="@color/modern_primary"
                    android:gravity="start"
                    android:text="00:00:00"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.03" />

                <View
                    android:id="@+id/statusIndicator"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/status_indicator_active"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="4dp">

                <!-- Play/Pause Button -->
                <ImageButton
                    android:id="@+id/playPauseButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_play"
                    android:background="@drawable/rounded_button_outline_green"
                    android:tint="@color/success_dark"
                    android:scaleType="centerInside"
                    android:padding="8dp" />

                <!-- Stop Button -->
                <ImageButton
                    android:id="@+id/stopButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:src="@drawable/ic_stop"
                    android:background="@drawable/rounded_button_outline_red"
                    android:tint="@color/error"
                    android:scaleType="centerInside"
                    android:padding="8dp"
                    android:visibility="gone" />

                <!-- Flip Button -->
                <ImageButton
                    android:id="@+id/flipButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_flip"
                    android:background="@drawable/rounded_button_outline_primary"
                    android:tint="@color/modern_primary"
                    android:scaleType="centerInside"
                    android:padding="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- BACK SIDE -->
        <LinearLayout
            android:id="@+id/card_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Header Section -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp">

                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="40dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_back"
                    android:background="@drawable/rounded_button_outline_primary"
                    android:tint="@color/modern_primary"
                    android:scaleType="centerInside"
                    android:padding="6dp" />

                <TextView
                    android:id="@+id/activityNameTextView1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/backButton"
                    android:layout_marginStart="12dp"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary"
                    android:gravity="center"
                    android:hint="Activity Details"
                    android:letterSpacing="0.01"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </RelativeLayout>

            <!-- Stats Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <!-- Total Time -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:cardUseCompatPadding="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/stat_item_background"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TOTAL TIME"
                                android:textSize="10sp"
                                android:textColor="@color/textSecondary"
                                android:textStyle="bold"
                                android:letterSpacing="0.03" />

                            <TextView
                                android:id="@+id/backTextView1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="00:00:00"
                                android:textSize="14sp"
                                android:textColor="@color/textPrimary"
                                android:textStyle="bold"
                                android:fontFamily="monospace"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Sessions -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:cardUseCompatPadding="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/stat_item_background"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SESSIONS"
                                android:textSize="10sp"
                                android:textColor="@color/textSecondary"
                                android:textStyle="bold"
                                android:letterSpacing="0.03" />

                            <TextView
                                android:id="@+id/backTextView2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="14sp"
                                android:textColor="@color/textPrimary"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Average Time -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:cardUseCompatPadding="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/stat_item_background"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="AVERAGE"
                                android:textSize="10sp"
                                android:textColor="@color/textSecondary"
                                android:textStyle="bold"
                                android:letterSpacing="0.03" />

                            <TextView
                                android:id="@+id/backTextView3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="00:00:00"
                                android:textSize="14sp"
                                android:textColor="@color/textPrimary"
                                android:textStyle="bold"
                                android:fontFamily="monospace"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Last Session -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:cardUseCompatPadding="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/stat_item_background"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="LAST SESSION"
                                android:textSize="10sp"
                                android:textColor="@color/textSecondary"
                                android:textStyle="bold"
                                android:letterSpacing="0.03" />

                            <TextView
                                android:id="@+id/backTextView4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="00:00:00"
                                android:textSize="14sp"
                                android:textColor="@color/textPrimary"
                                android:textStyle="bold"
                                android:fontFamily="monospace"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </LinearLayout>

            <!-- Bottom Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Reset Button -->
                <ImageButton
                    android:id="@+id/resetButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_reset"
                    android:background="@drawable/rounded_button_outline_red"
                    android:tint="@color/error"
                    android:scaleType="centerInside"
                    android:padding="8dp" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>