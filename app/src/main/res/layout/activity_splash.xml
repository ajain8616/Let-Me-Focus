<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    tools:context=".base.SplashActivity">

    <!-- Ambient Floating Blob 1 (Top-End) -->
    <ImageView
        android:id="@+id/bg_blob_1"
        android:layout_width="@dimen/blob_size_1"
        android:layout_height="@dimen/blob_size_1"
        android:alpha="0.14"
        app:srcCompat="@drawable/bg_blob_1"
        android:contentDescription="@string/blank"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Ambient Floating Blob 2 (Bottom-Start) -->
    <ImageView
        android:id="@+id/bg_blob_2"
        android:layout_width="@dimen/blob_size_2"
        android:layout_height="@dimen/blob_size_2"
        android:alpha="0.14"
        app:srcCompat="@drawable/bg_blob_2"
        android:contentDescription="@string/blank"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Main Hero Center Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/padding_screen"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.48">

        <!-- Glowing Glassmorphic App Logo Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/circular_shadow_size"
            android:layout_height="@dimen/circular_shadow_size"
            app:cardCornerRadius="@dimen/radius_header"
            app:cardElevation="@dimen/elevation_floating"
            app:strokeWidth="@dimen/stroke_thin"
            app:strokeColor="@color/glass_stroke_primary"
            app:cardBackgroundColor="@color/transparent">

            <ImageView
                android:id="@+id/app_logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/icon"
                android:contentDescription="@string/cd_app_icon" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Legacy View preserved for zero ID breakage -->
        <ImageView
            android:id="@+id/app_icon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:contentDescription="@string/cd_app_icon" />

        <!-- App Name Header -->
        <TextView
            android:id="@+id/app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_xlarge"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_hero"
            android:fontFamily="@font/bold"
            android:letterSpacing="0.02" />

        <!-- Subtitle / Tagline -->
        <TextView
            android:id="@+id/app_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:text="@string/nav_header_subtitle"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_subheading"
            android:fontFamily="@font/robotoregular"
            android:gravity="center"
            android:alpha="0.88" />

        <!-- Sleek Minimal Progress Indicator -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/loading_progress"
            android:layout_width="160dp"
            android:layout_height="@dimen/margin_tiny"
            android:layout_marginTop="@dimen/margin_xxlarge"
            app:trackColor="@color/glass_stroke_primary"
            app:trackCornerRadius="@dimen/radius_micro"
            app:indicatorColor="@color/modern_secondary" />

    </LinearLayout>

    <!-- Version Metadata at Bottom -->
    <TextView
        android:id="@+id/version_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_xxlarge"
        android:text="Version 2.0"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_caption"
        android:fontFamily="@font/robotoligth"
        android:letterSpacing="0.06"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>