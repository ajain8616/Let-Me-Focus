<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_light"
    android:theme="@style/Base.Theme.ActivityTracker"
    tools:context=".ActiveActivitiesFragment">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/activityNameLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/padding_large"
        android:paddingTop="@dimen/padding_large"
        android:paddingBottom="@dimen/padding_tiny">

        <TextView
            android:id="@+id/activityNameView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_active_activities"
            android:textSize="@dimen/text_size_large"
            android:textColor="@color/black"
            android:fontFamily="sans-serif-black" />
    </LinearLayout>

    <!-- Search Item Bar (Expandable) -->
    <RelativeLayout
        android:id="@+id/searchItemLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/activityNameLayout"
        android:layout_marginHorizontal="@dimen/margin_large"
        android:layout_marginTop="@dimen/margin_standard"
        android:background="@drawable/bg_action_bar_input"
        android:paddingHorizontal="@dimen/padding_medium"
        android:paddingVertical="@dimen/padding_tiny"
        android:elevation="@dimen/card_elevation"
        android:visibility="gone">

        <EditText
            android:id="@+id/itemSearch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_toStartOf="@id/clearButton"
            android:background="@null"
            android:hint="@string/hint_search_activity"
            android:textColor="@color/black"
            android:textColorHint="@color/light_gray"
            android:textSize="@dimen/text_size_body"
            android:inputType="text"
            android:imeOptions="actionSearch" />

        <ImageButton
            android:id="@+id/clearButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_clear"
            android:contentDescription="@string/cd_clear_search"
            app:tint="@color/light_gray" />
    </RelativeLayout>

    <!-- Add Item Bar (Expandable) -->
    <RelativeLayout
        android:id="@+id/addItemLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/searchItemLayout"
        android:layout_marginHorizontal="@dimen/margin_large"
        android:layout_marginTop="@dimen/margin_standard"
        android:background="@drawable/bg_action_bar_input"
        android:paddingHorizontal="@dimen/padding_medium"
        android:paddingVertical="@dimen/padding_tiny"
        android:elevation="@dimen/card_elevation"
        android:visibility="gone">

        <EditText
            android:id="@+id/itemName"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_toStartOf="@id/sendButton"
            android:background="@null"
            android:hint="@string/hint_activity_name"
            android:textColor="@color/black"
            android:textColorHint="@color/light_gray"
            android:textSize="@dimen/text_size_body"
            android:inputType="textCapSentences"
            android:imeOptions="actionDone" />

        <ImageButton
            android:id="@+id/sendButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_send"
            android:contentDescription="@string/cd_add_activity"
            app:tint="@color/colorRoyalBlue" />
    </RelativeLayout>

    <!-- Activities List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/activityRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/addItemLayout"
        android:layout_marginTop="@dimen/margin_standard"
        android:clipToPadding="false"
        android:paddingBottom="88dp"
        android:scrollbars="none"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <!-- Main Speed-Dial FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/fab_margin"
        android:layout_marginBottom="@dimen/fab_margin"
        android:src="@drawable/ic_more_vert"
        android:contentDescription="@string/cd_fab_menu"
        app:backgroundTint="@color/colorRoyalBlue"
        app:tint="@color/white"
        app:elevation="@dimen/card_elevation" />

    <!-- Add Sub-Action FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/addActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/fabActionButton"
        android:layout_alignStart="@id/fabActionButton"
        android:layout_marginBottom="@dimen/margin_large"
        android:src="@drawable/ic_add"
        android:contentDescription="@string/cd_fab_add"
        android:visibility="gone"
        app:fabSize="mini"
        app:backgroundTint="@color/colorPrimary"
        app:tint="@color/white"
        app:elevation="@dimen/card_elevation" />

    <!-- Search Sub-Action FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/searchActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/addActionButton"
        android:layout_alignStart="@id/addActionButton"
        android:layout_marginBottom="@dimen/margin_large"
        android:src="@drawable/ic_search"
        android:contentDescription="@string/cd_fab_search"
        android:visibility="gone"
        app:fabSize="mini"
        app:backgroundTint="@color/lavender"
        app:tint="@color/white"
        app:elevation="@dimen/card_elevation" />

</RelativeLayout>