<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".fragments.PieChartFragment">

    <!-- Background -->
    <View
        android:id="@+id/background_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_background" />

    <!-- Ambient Blobs -->
    <ImageView
        android:id="@+id/bg_blob_1"
        android:layout_width="@dimen/blob_size_1"
        android:layout_height="@dimen/blob_size_1"
        android:layout_gravity="top|end"
        android:alpha="0.08"
        android:src="@drawable/bg_blob_1"
        android:contentDescription="@string/blank" />

    <ImageView
        android:id="@+id/bg_blob_2"
        android:layout_width="@dimen/blob_size_2"
        android:layout_height="@dimen/blob_size_2"
        android:layout_gravity="bottom|start"
        android:alpha="0.08"
        android:src="@drawable/bg_blob_2"
        android:contentDescription="@string/blank" />

    <!-- App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/appbar_background_bottom_radius"
        android:elevation="@dimen/elevation_floating"
        android:fitsSystemWindows="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/padding_screen"
            android:paddingVertical="@dimen/padding_medium"
            app:layout_scrollFlags="enterAlways|snap">

            <TextView
                android:id="@+id/activityNameView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/title_activity_analysis"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/text_size_heading"
                android:fontFamily="@font/bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/actionButtonsLayout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/actionButtonsLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageButton
                    android:id="@+id/refreshButton"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:background="@drawable/rounded_button_background_secondary"
                    android:src="@drawable/ic_reset"
                    app:tint="@color/modern_primary"
                    android:contentDescription="@string/stop"
                    android:scaleType="centerInside" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_screen">

                <!-- Filter Chips Row -->
                <LinearLayout
                    android:id="@+id/filterButtonsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/margin_medium">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/filterTodayButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/margin_tiny"
                        android:text="Today"
                        android:textSize="@dimen/text_size_body_small"
                        android:fontFamily="@font/robotomedium"
                        android:backgroundTint="@color/surface"
                        app:strokeWidth="@dimen/stroke_thin"
                        app:strokeColor="@color/border_gray"
                        android:textColor="@color/textPrimary"
                        app:cornerRadius="@dimen/radius_medium" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/filterWeekButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="@dimen/margin_tiny"
                        android:text="Week"
                        android:textSize="@dimen/text_size_body_small"
                        android:fontFamily="@font/robotomedium"
                        android:backgroundTint="@color/surface"
                        app:strokeWidth="@dimen/stroke_thin"
                        app:strokeColor="@color/border_gray"
                        android:textColor="@color/textPrimary"
                        app:cornerRadius="@dimen/radius_medium" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/filterMonthButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/margin_tiny"
                        android:text="Month"
                        android:textSize="@dimen/text_size_body_small"
                        android:fontFamily="@font/robotomedium"
                        android:backgroundTint="@color/surface"
                        app:strokeWidth="@dimen/stroke_thin"
                        app:strokeColor="@color/border_gray"
                        android:textColor="@color/textPrimary"
                        app:cornerRadius="@dimen/radius_medium" />
                </LinearLayout>

                <!-- Overview Stats Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/statsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_large"
                    app:cardCornerRadius="@dimen/radius_xlarge"
                    app:cardElevation="@dimen/elevation_card"
                    app:strokeWidth="@dimen/stroke_thin"
                    app:strokeColor="@color/border_gray"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/padding_large">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Activity Overview"
                            android:textSize="@dimen/text_size_title"
                            android:fontFamily="@font/bold"
                            android:textColor="@color/textPrimary"
                            android:layout_marginBottom="@dimen/margin_medium" />

                        <!-- Stats Row 1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="@drawable/stat_item_background"
                                android:padding="@dimen/padding_medium"
                                android:layout_marginEnd="@dimen/margin_tiny">

                                <TextView
                                    android:id="@+id/totalTimeText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/timer_default_value"
                                    android:textSize="@dimen/text_size_title"
                                    android:fontFamily="@font/bold"
                                    android:textColor="@color/modern_primary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/label_total_spent_time"
                                    android:textSize="@dimen/text_size_caption"
                                    android:fontFamily="@font/robotoregular"
                                    android:textColor="@color/textSecondary"
                                    android:layout_marginTop="@dimen/margin_micro" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="@drawable/stat_item_background"
                                android:padding="@dimen/padding_medium"
                                android:layout_marginStart="@dimen/margin_tiny">

                                <TextView
                                    android:id="@+id/totalSessionsText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textSize="@dimen/text_size_title"
                                    android:fontFamily="@font/bold"
                                    android:textColor="@color/statusSuccess" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/label_count_sessions"
                                    android:textSize="@dimen/text_size_caption"
                                    android:fontFamily="@font/robotoregular"
                                    android:textColor="@color/textSecondary"
                                    android:layout_marginTop="@dimen/margin_micro" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Stats Row 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="@dimen/margin_small">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="@drawable/stat_item_background"
                                android:padding="@dimen/padding_medium"
                                android:layout_marginEnd="@dimen/margin_tiny">

                                <TextView
                                    android:id="@+id/activitiesCountText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0/0"
                                    android:textSize="@dimen/text_size_body_large"
                                    android:fontFamily="@font/bold"
                                    android:textColor="@color/textPrimary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Activities"
                                    android:textSize="@dimen/text_size_caption"
                                    android:fontFamily="@font/robotoregular"
                                    android:textColor="@color/textSecondary" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="@drawable/stat_item_background"
                                android:padding="@dimen/padding_medium"
                                android:layout_marginHorizontal="@dimen/margin_tiny">

                                <TextView
                                    android:id="@+id/avgSessionText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="00:00"
                                    android:textSize="@dimen/text_size_body_large"
                                    android:fontFamily="@font/bold"
                                    android:textColor="@color/warning_dark" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Avg/Session"
                                    android:textSize="@dimen/text_size_caption"
                                    android:fontFamily="@font/robotoregular"
                                    android:textColor="@color/textSecondary" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="@drawable/stat_item_background"
                                android:padding="@dimen/padding_medium"
                                android:layout_marginStart="@dimen/margin_tiny">

                                <TextView
                                    android:id="@+id/mostActiveText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/default_empty_value"
                                    android:textSize="@dimen/text_size_body_large"
                                    android:fontFamily="@font/bold"
                                    android:textColor="@color/textPrimary"
                                    android:maxLines="1"
                                    android:ellipsize="end" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Most Active"
                                    android:textSize="@dimen/text_size_caption"
                                    android:fontFamily="@font/robotoregular"
                                    android:textColor="@color/textSecondary" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Pie Chart Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/radius_xlarge"
                    app:cardElevation="@dimen/elevation_card"
                    app:strokeWidth="@dimen/stroke_thin"
                    app:strokeColor="@color/border_gray"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/padding_large">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Time Distribution"
                            android:textSize="@dimen/text_size_title"
                            android:fontFamily="@font/bold"
                            android:textColor="@color/textPrimary"
                            android:gravity="center"
                            android:layout_marginBottom="@dimen/margin_standard" />

                        <com.github.mikephil.charting.charts.PieChart
                            android:id="@+id/pieChart"
                            android:layout_width="match_parent"
                            android:layout_height="320dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Empty State -->
                <LinearLayout
                    android:id="@+id/emptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone"
                    android:paddingVertical="@dimen/padding_hero">

                    <ImageView
                        android:layout_width="@dimen/empty_state_image_size"
                        android:layout_height="@dimen/empty_state_image_size"
                        android:src="@drawable/error_no_data"
                        android:alpha="0.8"
                        android:contentDescription="@string/default_empty_value" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_large"
                        android:text="No activity data available"
                        android:textSize="@dimen/text_size_title"
                        android:fontFamily="@font/bold"
                        android:textColor="@color/textPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_tiny"
                        android:text="@string/subtitle_analytics"
                        android:textSize="@dimen/text_size_body"
                        android:fontFamily="@font/robotoregular"
                        android:textColor="@color/textSecondary" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Loading Progress -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/modern_primary"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>