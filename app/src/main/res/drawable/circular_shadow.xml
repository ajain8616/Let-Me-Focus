<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Ambient Shadow Layer -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent"/>
            <corners android:radius="@dimen/radius_oval_shadow"/>
            <padding
                android:left="@dimen/padding_tiny"
                android:top="@dimen/padding_tiny"
                android:right="@dimen/padding_tiny"
                android:bottom="@dimen/padding_tiny"/>
            <size
                android:width="@dimen/circular_shadow_size"
                android:height="@dimen/circular_shadow_size"/>
            <gradient
                android:startColor="@color/shadow_color"
                android:endColor="@android:color/transparent"
                android:angle="90"/>
        </shape>
    </item>

    <!-- Inner Circle (Avatar Surface) -->
    <item
        android:top="@dimen/radius_none"
        android:left="@dimen/radius_none"
        android:right="@dimen/radius_none"
        android:bottom="@dimen/radius_none">
        <shape android:shape="oval">
            <solid android:color="@color/surface_white"/>
        </shape>
    </item>

</layer-list>