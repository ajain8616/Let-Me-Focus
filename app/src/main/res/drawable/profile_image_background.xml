<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <solid android:color="@color/shadow_color" />
            <size
                android:width="@dimen/avatar_shadow_size"
                android:height="@dimen/avatar_shadow_size" />
            <corners android:radius="@dimen/radius_avatar_outer" />
        </shape>
    </item>

    <item
        android:top="@dimen/padding_standard"
        android:left="@dimen/padding_standard"
        android:right="@dimen/padding_standard"
        android:bottom="@dimen/padding_standard">
        <shape android:shape="oval">
            <solid android:color="@color/surface_white" />
            <size
                android:width="@dimen/avatar_bg_size"
                android:height="@dimen/avatar_bg_size" />
            <corners android:radius="@dimen/radius_avatar" />
        </shape>
    </item>

</layer-list>