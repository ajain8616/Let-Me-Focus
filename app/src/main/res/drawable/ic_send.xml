<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Soft Mint Oval Background -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/modern_primary_light" />
            <size
                android:width="@dimen/icon_button_size"
                android:height="@dimen/icon_button_size" />
        </shape>
    </item>

    <!-- Subtle Emerald Border -->
    <item
        android:left="@dimen/padding_micro"
        android:right="@dimen/padding_micro"
        android:top="@dimen/padding_micro"
        android:bottom="@dimen/padding_micro">
        <shape android:shape="oval">
            <stroke
                android:width="@dimen/stroke_thin"
                android:color="@color/modern_primary" />
        </shape>
    </item>

    <!-- Centered Deep Emerald Send Arrow -->
    <item android:gravity="center">
        <vector
            android:width="@dimen/icon_size_standard"
            android:height="@dimen/icon_size_standard"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <path
                android:fillColor="@color/modern_primary"
                android:pathData="M2.01,21L23,12 2.01,3 2,10l15,2 -15,2z" />
        </vector>
    </item>

</layer-list>