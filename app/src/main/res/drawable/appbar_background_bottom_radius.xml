<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 2026 Acrylic Glassmorphism Surface -->
    <solid android:color="@color/glass_surface_primary" />

    <!-- Luminous Edge Stroke -->
    <stroke
        android:width="@dimen/stroke_thin"
        android:color="@color/glass_stroke_primary" />

    <!-- Ergonomic Bottom Rounded Corners -->
    <corners
        android:topLeftRadius="@dimen/radius_none"
        android:topRightRadius="@dimen/radius_none"
        android:bottomLeftRadius="@dimen/radius_header"
        android:bottomRightRadius="@dimen/radius_header" />

</shape>